[
  {
    "id": "jobhuntIndiaIngestionV1",
    "name": "JobHunt India — Discover & Ingest Jobs",
    "active": false,
    "nodes": [
      {
        "parameters": {},
        "id": "manual-trigger",
        "name": "Run Now",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [-40, -260]
      },
      {
        "parameters": {
          "rule": {
            "interval": [{ "field": "hours", "hoursInterval": 4 }]
          }
        },
        "id": "incremental-schedule",
        "name": "Every 4 Hours",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.3,
        "position": [-40, -80]
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "days",
                "daysInterval": 1,
                "triggerAtHour": 2,
                "triggerAtMinute": 20
              }
            ]
          }
        },
        "id": "recent-schedule",
        "name": "Daily Recent Board Discovery",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.3,
        "position": [-40, 100]
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "months",
                "monthsInterval": 1,
                "triggerAtDayOfMonth": 1,
                "triggerAtHour": 3,
                "triggerAtMinute": 10
              }
            ]
          }
        },
        "id": "full-schedule",
        "name": "Monthly Full Board Discovery",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.3,
        "position": [-40, 280]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "manual-mode-value",
                "name": "mode",
                "value": "incremental",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "manual-mode",
        "name": "Mode — Manual Incremental",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [220, -260]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "incremental-mode-value",
                "name": "mode",
                "value": "incremental",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "incremental-mode",
        "name": "Mode — Incremental",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [220, -80]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "recent-mode-value",
                "name": "mode",
                "value": "refresh_recent",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "recent-mode",
        "name": "Mode — Recent Discovery",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [220, 100]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "full-mode-value",
                "name": "mode",
                "value": "full_discovery",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "full-mode",
        "name": "Mode — Full Discovery",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [220, 280]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://jobhunt.prakhar.wtf/api/admin/ingest",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ { mode: $json.mode } }}",
          "options": {
            "timeout": 30000
          }
        },
        "id": "start-ingestion",
        "name": "Start Ingestion",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [510, 10],
        "credentials": {
          "httpHeaderAuth": {
            "id": "jobhunt-ingest-header-v1",
            "name": "JobHunt Ingestion API"
          }
        }
      },
      {
        "parameters": {
          "amount": 45,
          "unit": "seconds"
        },
        "id": "wait-for-ingestion",
        "name": "Wait 45 Seconds",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1.1,
        "position": [750, 10],
        "webhookId": "jobhunt-ingestion-wait-v1"
      },
      {
        "parameters": {
          "url": "=https://jobhunt.prakhar.wtf/api/admin/runs/{{$node[\"Start Ingestion\"].json[\"run_id\"]}}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {
            "timeout": 30000
          }
        },
        "id": "get-run-status",
        "name": "Get Run Status",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [990, 10],
        "credentials": {
          "httpHeaderAuth": {
            "id": "jobhunt-ingest-header-v1",
            "name": "JobHunt Ingestion API"
          }
        }
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "running-condition",
                "leftValue": "={{ ['queued', 'running'].includes($json.status) }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "still-running",
        "name": "Still Running?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [1230, 10]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "completed-condition",
                "leftValue": "={{ $json.status }}",
                "rightValue": "completed",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "run-succeeded",
        "name": "Run Succeeded?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [1470, 110]
      },
      {
        "parameters": {},
        "id": "complete",
        "name": "Ingestion Complete",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [1710, 50]
      },
      {
        "parameters": {
          "errorMessage": "=JobHunt ingestion failed: {{$json.error || $json.status}}"
        },
        "id": "fail-workflow",
        "name": "Fail Workflow",
        "type": "n8n-nodes-base.stopAndError",
        "typeVersion": 1,
        "position": [1710, 180]
      }
    ],
    "connections": {
      "Run Now": { "main": [[{ "node": "Mode — Manual Incremental", "type": "main", "index": 0 }]] },
      "Every 4 Hours": { "main": [[{ "node": "Mode — Incremental", "type": "main", "index": 0 }]] },
      "Daily Recent Board Discovery": { "main": [[{ "node": "Mode — Recent Discovery", "type": "main", "index": 0 }]] },
      "Monthly Full Board Discovery": { "main": [[{ "node": "Mode — Full Discovery", "type": "main", "index": 0 }]] },
      "Mode — Manual Incremental": { "main": [[{ "node": "Start Ingestion", "type": "main", "index": 0 }]] },
      "Mode — Incremental": { "main": [[{ "node": "Start Ingestion", "type": "main", "index": 0 }]] },
      "Mode — Recent Discovery": { "main": [[{ "node": "Start Ingestion", "type": "main", "index": 0 }]] },
      "Mode — Full Discovery": { "main": [[{ "node": "Start Ingestion", "type": "main", "index": 0 }]] },
      "Start Ingestion": { "main": [[{ "node": "Wait 45 Seconds", "type": "main", "index": 0 }]] },
      "Wait 45 Seconds": { "main": [[{ "node": "Get Run Status", "type": "main", "index": 0 }]] },
      "Get Run Status": { "main": [[{ "node": "Still Running?", "type": "main", "index": 0 }]] },
      "Still Running?": {
        "main": [
          [{ "node": "Wait 45 Seconds", "type": "main", "index": 0 }],
          [{ "node": "Run Succeeded?", "type": "main", "index": 0 }]
        ]
      },
      "Run Succeeded?": {
        "main": [
          [{ "node": "Ingestion Complete", "type": "main", "index": 0 }],
          [{ "node": "Fail Workflow", "type": "main", "index": 0 }]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1",
      "timezone": "Europe/Berlin",
      "saveManualExecutions": true,
      "callerPolicy": "workflowsFromSameOwner"
    },
    "staticData": null,
    "meta": {
      "templateCredsSetupCompleted": true
    },
    "pinData": {},
    "tags": []
  }
]

